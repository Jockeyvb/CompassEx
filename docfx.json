{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
  {
    "src": [{ "files": [ "CompassEx/CompassEx.csproj" ], "cwd": "CompassEx", "exclude": [ "**/bin/**", "**/obj/**" ] }],
    "dest": "api/CompassEx"  
  },
  {
    "src": [{ "files": [ "CommLib/CommLib.csproj" ], "cwd": "CommLib", "exclude": [ "**/bin/**", "**/obj/**" ] }],
    "dest": "api/CommLib"  
  }
],
  "build": {
    
     "warningsAsErrors": false,
    "content": [
  {
    "files": [
      "toc.yml",
      "index.md",
      "*.md",
      "api/**/toc.yml", 
        "api/**/*.yml"
    ],
    "exclude": [ "_site/**" ]
  }
],
    "resource": [
      {
        "files": [
          "Images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default", "default(zh-cn)", "modern",
      "templates"
    ],
    "globalMetadata": {
      "_appName": "CompassEx",
      "_appTitle": "罗盘算法类库",
      "_enableSearch": false, 
      "_appLogoPath": "",
       "_appLang": "zh-CN",
      "pdf": true,
         "_appLogoPath": "Images/logo.png",       
      "_appFaviconPath": "Images/logo.png",  
    }
  }
}
