<?xml version="1.0" encoding="utf-8" ?>
<mopups:PopupPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                  xmlns:mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
                  x:Class="CompassExTest.Pages.Controls.HudMessagePopup"
                  BackgroundColor="Transparent">

    <Border BackgroundColor="#CC000000" 
            StrokeShape="RoundRectangle 20" 
            Padding="15,10,15,10" 
            HorizontalOptions="Center"
            VerticalOptions="End"
            Margin="0,0,0,80" 
            StrokeThickness="0">
    
        <Border.Shadow>
            <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.3"/>
        </Border.Shadow>
        <VerticalStackLayout HorizontalOptions="Fill" BackgroundColor="#220000" >
            <Label x:Name="TxtMessage" 
               TextColor="White" 
               FontSize="13" 
               LineBreakMode="WordWrap" 
               HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>
    </Border>
</mopups:PopupPage>
